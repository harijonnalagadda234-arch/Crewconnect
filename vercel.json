{
  "builds": [
    {
      "src": "Crewconnect/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "includeFiles": ["static/**", "staticfiles/**", "templates/**"]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "Crewconnect/wsgi.py" }
  ]
}